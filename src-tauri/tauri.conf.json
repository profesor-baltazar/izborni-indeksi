{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electoral and Party System Indices",
  "version": "1.4.0",
  "identifier": "app.izborniindeksi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Electoral & Party System Indices",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Electoral and party system indices",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
